// Mappe un statut d'affectation vers une classe CSS de badge
export const classeBadgeAffectation = (statut) => {
  switch (statut) {
    case "Active":
      return "statut-en-cours";
    case "Terminée":
      return "statut-termine";
    case "Annulée":
      return "statut-annule";
    default:
      return "statut-en-cours";
  }
};

